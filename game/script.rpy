# ==========================================
# Визуальная новелла «Второй экземпляр»
# ==========================================

define t = Character("Тимур", color="#ffffff")
define k = Character("Катя", color="#ffcc55")
define u = Character("Учительница", color="#88aaff")
define narrator = Character(None, what_italic=True)

# Объявляем фоны с их реальными расширениями из папки images
image bg_room_timur_1 = im.Scale("bg_room_timur_1.jpg", 1920, 1080)
image bg_room_timur_2 = im.Scale("bg_room_timur_2.jpg", 1920, 1080)
image bg_street = im.Scale("bg_street.jpg", 1920, 1080)
image bg_school_corridor = im.Scale("bg_school_corridor.png", 1920, 1080)

label start:

    # ------------------------------------------
    # Сцена 1. Пробуждение
    # ------------------------------------------
    scene bg_room_timur_1 with dissolve

    t "Голова тяжёлая... Сколько я проспал? Кажется, температура наконец спала."
    
    t "В ушах всё ещё звенит от этого душного бреда."

    scene black with dissolve


    # ------------------------------------------
    # Сцена 2. Окно и кот
    # ------------------------------------------
    scene bg_room_timur_2 with dissolve

    t "Три дня дома. Три дня без школы, без людей и без этого вечного шума."
    
    t "Казалось бы, обычная простуда. Пора возвращаться к жизни."
    
    t "Но, стоя здесь, у окна... я чувствую, что возвращаться совсем не хочется."

    scene black with dissolve


    # ------------------------------------------
    # Сцена 3. Дорога в школу
    # ------------------------------------------
    scene bg_street with dissolve

    t "Утро сырое и туманное. Воздух почти обжигает лёгкие после трёх дней в квартире."

    t "Странно... Обычно в это время мы встречаемся с Данияром у перекрёстка."

    t "Наверное, он уже ушёл вперёд и ждёт в классе."

    scene black with dissolve


    # ------------------------------------------
    # Сцена 4. Школьный коридор
    # ------------------------------------------
    scene bg_school_corridor with dissolve

    t "Шум, крики, топот обуви по линолеуму. Школа живёт своей обычной жизнью."

    t "Но в этом шуме есть что-то давящее. Как будто всё вокруг размывается."


    # ------------------------------------------
    # Сцена 5. Класс — исчезновение Данияра
    # ------------------------------------------
    scene bg_school_corridor with dissolve

    show katya normal at right with dissolve

    k "О, живой! Мы уже думали, ты на этой неделе вообще не появишься."

    t "Да нет, обычная простуда. Что пропустил?"

    k "Да ничего интересного. Контрольную по математике, если тебе повезёт."

    t "Вот это поддержка."

    k "Всегда пожалуйста."

    t "Слушай, Данияр приходил вчера?"

    k "Какой Данияр?"

    t "Данияр. Из нашего класса."

    k "Тимур, у нас нет никакого Данияра."

    t "Очень смешно."

    k "Я серьёзно. Ты о ком вообще?"

    hide katya with dissolve


    # ------------------------------------------
    # Сцена 6. Класс — временной сбой
    # ------------------------------------------
    t "Что за бред? Никакого Данияра... Серьёзно? Мы же вчера вместе скидывали проект по информатике."

    t "Или... мне это приснилось? Но как мог присниться человек, с которым я общался год?"

    u "Тимур! Ты меня вообще слушаешь? Ты всю неделю болел, а теперь на уроках витаешь в облаках."

    t "Да, извините... Слушаю."

    u "Тогда ответь мне, какой сегодня день недели?"

    t "Четверг... вроде бы?"

    show katya normal at right with dissolve

    k "Тимур, ты совсем с дуба рухнул? Какой четверг? Сегодня вторник."

    hide katya with dissolve

    t "Вторник?.. Но я же чётко помню, что пропустил среду. Или не пропустил?.."

    t "Куда делся целый день?"

    scene black with dissolve
    pause 1.0

    return